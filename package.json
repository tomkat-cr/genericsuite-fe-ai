{
  "name": "genericsuite-ai",
  "version": "1.2.0",
  "description": "The GenericSuite AI for ReactJS (frontend version).",
  "author": "Carlos J. Ramirez",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "Makefile",
    "webpack.config.js",
    "config-overrides.js",
    "vite.config.mjs",
    "index.html",
    "jest.config.cjs",
    ".env.example",
    "CHANGELOG.md",
    "src/lib/images",
    "src/lib/helpers/iconsLibAiExtras.jsx",
    "src/lib/constants/class_name_constants.jsx",
    "src/lib/test-helpers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomkat-cr/genericsuite-fe-ai.git"
  },
  "bugs": {
    "url": "https://github.com/tomkat-cr/genericsuite-fe-ai/issues"
  },
  "homepage": "https://genericsuite.carlosjramirez.com/Frontend-Development/GenericSuite-AI/",
  "keywords": [
    "ai",
    "chatbot",
    "llm",
    "nlp",
    "react",
    "reactjs",
    "react-bootstrap",
    "react-hooks",
    "webpack"
  ],
  "scripts": {
    "start": "node server.js",
    "start-build": "./node_modules/react-app-rewired/bin/react-app-rewired.js build && node server.js",
    "start-debug": "ls -lah && node server.js",
    "start-dev": "react-app-rewired start",
    "start-dev-webpack": "npx webpack-dev-server --config webpack.config.js",
    "start-dev-vite": "npx vite dev",
    "build-prod": "webpack --mode production",
    "heroku-postbuild": "npm run build",
    "build-dev": "react-app-rewired build",
    "build": "rm -rf dist && rollup -c",
    "eject-dev": "react-scripts eject",
    "test-dev": "react-app-rewired test",
    "test": "jest",
    "//": "See https://stackoverflow.com/questions/70368760/react-uncaught-referenceerror-process-is-not-defined",
    "// preinstall": "npx npm-force-resolutions",
    "predeploy": "npm run build",
    "deploy": "# gh-pages -d build # Uncomment this line to deploy to github pages and run 'npm install -D gh-pages'",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0-placeholder-for-preset-env.2",
    "@babel/plugin-syntax-jsx": "^7.23.3",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "@types/react": "^18.2.63",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-css-modules-transform": "^1.6.2",
    "genericsuite-fe-scripts": "github:tomkat-cr/genericsuite-fe-scripts#develop",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "postcss": "^8.5.6",
    "react-test-renderer": "^18.2.0",
    "rollup": "^4.59.0",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svg": "^2.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "axios": "^1.19.0",
    "genericsuite": "github:tomkat-cr/genericsuite-fe#develop",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-overlay": "6.0.9",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "engines": {
    "node": ">= 18.12.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "fs": false
  },
  "overrides": {
    "elliptic": "^6.6.1",
    "json5": "^1.0.2",
    "minimatch": "^10.2.1",
    "postcss": "$postcss",
    "loader-utils": "^2.0.4"
  }
}
